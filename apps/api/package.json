{
  "name": "@machvon/api",
  "version": "0.0.0",
  "private": true,
  "main": "src/main.ts",
  "types": "src/main.ts",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc --noEmit -p tsconfig.json",
    "start": "node --disable-warning=ExperimentalWarning --import ./scripts/ts-register.mjs src/serve.ts",
    "e2e:stack": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --coverage=false --runInBand --forceExit --testMatch \"<rootDir>/test/e2e-stack/serve.stack.ts\"",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --coverage"
  },
  "jest": {
    "preset": "../../jest.preset.cjs",
    "setupFiles": [
      "reflect-metadata"
    ],
    "testMatch": [
      "<rootDir>/src/**/*.test.ts",
      "<rootDir>/test/**/*.test.ts"
    ],
    "transform": {
      "^.+.ts$": [
        "@swc/jest",
        {
          "jsc": {
            "target": "es2022",
            "parser": {
              "syntax": "typescript",
              "decorators": true
            },
            "transform": {
              "legacyDecorator": true,
              "decoratorMetadata": true
            }
          }
        }
      ]
    },
    "maxWorkers": 4,
    "globalSetup": "<rootDir>/../../packages/db/jest.global-setup.mjs",
    "globalTeardown": "<rootDir>/../../packages/db/jest.global-teardown.mjs"
  },
  "dependencies": {
    "@machvon/contracts": "*",
    "@machvon/db": "*",
    "@machvon/design-tokens": "*",
    "@machvon/kernel": "*",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@pdf-lib/fontkit": "1.1.1",
    "ajv": "8.17.1",
    "asn1js": "3.0.10",
    "pdf-lib": "1.17.1",
    "pkijs": "3.4.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.7",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1"
  }
}
