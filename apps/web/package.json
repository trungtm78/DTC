{
  "name": "@machvon/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p e2e/tsconfig.json",
    "test": "vitest run --coverage && node --test e2e/support/*.test.ts",
    "routes:generate": "node --disable-warning=ExperimentalWarning scripts/generate-routes.mjs generate",
    "routes:check": "node --disable-warning=ExperimentalWarning scripts/generate-routes.mjs check",
    "e2e": "playwright test e2e/route-walk.spec.ts e2e/visual.spec.ts",
    "e2e:walk": "playwright test e2e/route-walk.spec.ts",
    "e2e:visual": "playwright test e2e/visual.spec.ts"
  },
  "dependencies": {
    "@machvon/api-client": "*",
    "@machvon/design-tokens": "*",
    "@tanstack/react-query": "5.104.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/pngjs": "6.0.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "3.2.7",
    "jsdom": "26.1.0",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "vite": "6.4.4",
    "vitest": "3.2.7"
  }
}
