{
  "name": "machvon-design-tools",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Consistency checks and document generation for the MACHVON design package",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-include=src/**",
    "check": "node src/check-cli.mjs",
    "build": "node src/build-cli.mjs --pages --pdf"
  },
  "dependencies": {
    "marked": "^18.1.1",
    "puppeteer-core": "^25.15.0"
  }
}
