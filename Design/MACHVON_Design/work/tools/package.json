{
  "name": "machvon-design-tools",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Consistency checks and document generation for the MACHVON design package",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-include=src/**",
    "check": "node src/check-cli.mjs",
    "build": "node src/build-cli.mjs --pages --pdf",
    "merge": "node src/merge-cli.mjs",
    "ledger": "node src/legal-ledger-cli.mjs",
    "baseline": "node src/baseline-cli.mjs",
    "plan-link": "node src/plan-link-cli.mjs",
    "prototype-sync": "node src/prototype-sync-cli.mjs",
    "erd": "node src/erd-cli.mjs",
    "error-codes": "node src/error-code-inventory.mjs",
    "error-registry": "node src/error-code-registry.mjs"
  },
  "dependencies": {
    "marked": "^18.1.1",
    "puppeteer-core": "^25.15.0"
  }
}
