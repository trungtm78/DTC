# Copy to .env (never committed). Values are supplied by the environment or a secret manager.
# One connection string per database role of the API process (never one role for everything).
DATABASE_URL_APP=
DATABASE_URL_CONTROL=
DATABASE_URL_OUTBOX_RELAY=
# Signs the worker context of outbox deliveries: base64 of at least 32 random bytes.
OUTBOX_SIGNING_KEY=
OIDC_IDENTITY_AUDIENCE=
OIDC_CONTROL_AUDIENCE=
# Runtime (optional): PORT=3000, MAX_BODY_BYTES=1048576, SHUTDOWN_TIMEOUT_MS=15000, CORS_ORIGINS=https://app.example.test,
# ALERT_WEBHOOK_URL=https://pager.example.test/hook (operations alerts are always logged; the webhook is optional)
# MIGRATIONS_DIR=db/migrations, TELEMETRY_EXPORTER=none|console|otlp (OTLP_ENDPOINT=http://collector:4318 for otlp), OTEL_SERVICE_NAME=machvon-api
JWT_PRIVATE_KEY_PEM_PATH=
JWT_PUBLIC_KEY_PEM_PATH=
JWT_KEY_ID=
# Authentication (ST-IAM-002 backend): the identity provider and the key that signs tenant access tokens.
OIDC_ISSUER=
OIDC_JWKS_URI=
TENANT_TOKEN_ISSUER=
TENANT_TOKEN_SIGNING_KEY_PEM_PATH=
TENANT_TOKEN_KEY_ID=
# Optional during a rotation: the previous key stays published for tokens that are still valid.
TENANT_TOKEN_RETIRED_KEY_PEM_PATH=
TENANT_TOKEN_RETIRED_KEY_ID=
# License signing (ST-SAS-003): the Ed25519 key that signs licenses (PKCS8 PEM file, mounted by the secret store; never the key itself).
LICENSE_SIGNING_KEY_ID=
LICENSE_SIGNING_KEY_PEM_PATH=
# Optional during a rotation: the previous key (public half) stays published while licenses it signed are valid.
LICENSE_RETIRED_KEY_ID=
LICENSE_RETIRED_KEY_PUBLIC_PEM_PATH=
