# Copy to .env (never committed). Values are supplied by the environment or a secret manager.
DATABASE_URL=
JWT_PRIVATE_KEY_PEM_PATH=
JWT_PUBLIC_KEY_PEM_PATH=
JWT_KEY_ID=
# Authentication (ST-IAM-002 backend): the identity provider and the key that signs tenant access tokens.
OIDC_ISSUER=
OIDC_JWKS_URI=
TENANT_TOKEN_ISSUER=
TENANT_TOKEN_SIGNING_KEY_PEM_PATH=
TENANT_TOKEN_KEY_ID=
# Optional during a rotation: the previous key stays published for tokens that are still valid.
TENANT_TOKEN_RETIRED_KEY_PEM_PATH=
TENANT_TOKEN_RETIRED_KEY_ID=
