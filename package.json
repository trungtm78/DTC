{
  "name": "machvon",
  "version": "0.0.0",
  "private": true,
  "description": "MACHVON platform monorepo (tenant-isolated kernel, database, contracts, API)",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint . && npm run lint:error-codes && npm run commands:check && npm run i18n:check && npm run tokens:check && npm run routes:check -w @machvon/web && npm run migrations:check && npm run expand-contract:check && npm run infra:check && npm run alerts:check && npm run uat:check",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present && node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-include=scripts/architecture-check.mjs --test-coverage-include=scripts/lint-error-codes.mjs --test-coverage-include=scripts/command-coverage.mjs --test-coverage-include=scripts/i18n-lint.mjs --test-coverage-include=scripts/lane.mjs --test-coverage-include=scripts/migrations-check.mjs --test-coverage-include=scripts/sbom.mjs --test-coverage-include=scripts/supply-chain-check.mjs --test-coverage-include=scripts/infra-check.mjs --test-coverage-include=scripts/alerts-check.mjs --test-coverage-include=scripts/expand-contract-check.mjs --test-coverage-include=scripts/deploy-gate.mjs --test-coverage-include=scripts/uat-trace.mjs --test-coverage-include=scripts/ai-eval/harness.mjs --test-coverage-include=scripts/ai-eval/mock-route.mjs scripts/*.test.mjs",
    "architecture": "node scripts/architecture-check.mjs",
    "contracts:generate": "npm run contracts:generate -w @machvon/contracts",
    "contracts:check": "npm run contracts:check -w @machvon/contracts",
    "contracts:compat": "npm run contracts:compat -w @machvon/contracts",
    "db:generate": "npm run db:generate -w @machvon/db",
    "db:migrate": "npm run db:migrate -w @machvon/db",
    "db:check": "npm run db:check -w @machvon/db",
    "migrations:check": "node scripts/migrations-check.mjs",
    "sbom": "node scripts/sbom.mjs",
    "supply-chain:check": "node scripts/supply-chain-check.mjs",
    "infra:check": "node scripts/infra-check.mjs",
    "alerts:check": "node scripts/alerts-check.mjs",
    "uat:trace": "node scripts/uat-trace.mjs",
    "uat:check": "node scripts/uat-trace.mjs --check",
    "expand-contract:check": "node scripts/expand-contract-check.mjs",
    "jobs:run": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/jobs-run.mjs",
    "test:lane": "node scripts/lane.mjs",
    "lint:error-codes": "node scripts/lint-error-codes.mjs",
    "commands:check": "node scripts/command-coverage.mjs",
    "i18n:check": "node scripts/i18n-lint.mjs",
    "tokens:generate": "npm run tokens:generate -w @machvon/design-tokens",
    "tokens:check": "npm run tokens:check -w @machvon/design-tokens"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@swc/core": "^1.16.0",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "fast-check": "4.10.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  },
  "allowScripts": {
    "@swc/core": true,
    "@parcel/watcher": false,
    "unrs-resolver": false,
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true,
    "@embedded-postgres/linux-x64@18.4.0-beta.17": true,
    "@embedded-postgres/linux-arm64@18.4.0-beta.17": true,
    "@embedded-postgres/darwin-arm64@18.4.0-beta.17": true,
    "@embedded-postgres/darwin-x64@18.4.0-beta.17": true,
    "esbuild": false
  }
}
