{
  "name": "machvon",
  "version": "0.0.0",
  "private": true,
  "description": "MACHVON platform monorepo (tenant-isolated kernel, database, contracts, API)",
  "engines": { "node": ">=22" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present && node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-include=scripts/architecture-check.mjs scripts/*.test.mjs",
    "architecture": "node scripts/architecture-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@swc/core": "^1.16.0",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^9.39.0",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  },
  "allowScripts": {
    "@swc/core": true,
    "@parcel/watcher": false,
    "unrs-resolver": false
  }
}
